abi <abi/3.0>,
include <tunables/global>
/home/sachin/p2 {
  network inet stream,
  owner /tmp/project2* rw,
  owner @{HOME}/.proj2/ rw,
  owner @{HOME}/.proj2/config rw,
  owner @{HOME}/template r,
  /var/log/syslog r,
  /etc/{fstab,crontab,passwd,hosts} r,
  /run/{sshd.pid,systemd/resolve/stub-resolv.conf} r,
  /proc/{version,stat,buddyinfo} r,
  /sys/devices/system/cpu/cpu0/power/control r,
}
